# Copy to .env for local development. Do not commit real values.
# Set the same names in the Vercel project. Leave a value empty until it exists.

# Long random string used to sign sign-in links and the session cookie.
SESSION_SECRET=

# Production organization token. Needs products, checkouts, webhooks, customers,
# and subscriptions read/write as appropriate, plus customer_sessions:write.
POLAR_ACCESS_TOKEN=
# Signing secret returned when the webhook endpoint is created.
POLAR_WEBHOOK_SECRET=
# Polar environment used by the SDK checkout client.
POLAR_SERVER=production

# ClearFrame organization and Pro product. These are identifiers, not the access token.
POLAR_ORG_ID=451754ed-9a0e-4fcb-be7f-5e15db2a9b9b
POLAR_PRODUCT_ID=f89c5925-7362-40aa-9ce3-e69ff81005b5

# Public site origin, no trailing slash. Magic links are built from this.
SITE_URL=https://getclearframe.app

# Resend-compatible email API. Leave EMAIL_API_KEY empty in local development to print the magic link in the server log.
EMAIL_API_KEY=
EMAIL_FROM=
